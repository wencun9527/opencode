# PVF AI Editor - Caddy Reverse Proxy
# IP 直连模式（无域名，HTTP only）

:80 {
	# 日志
	log {
		output stdout
		format console
	}

	# OpenCode REST API
	handle /api/* {
		reverse_proxy opencode:8080
	}

	# OpenCode SSE (Server-Sent Events)
	handle /sse/* {
		reverse_proxy opencode:8080 {
			flush_interval -1
		}
	}

	# MCP StreamableHTTP → Tool Relay
	handle /mcp/* {
		reverse_proxy relay:9100
	}

	# 用量/管理 API → Relay
	handle /admin/* {
		reverse_proxy relay:9100
	}

	# 认证 API → Relay
	handle /auth/* {
		reverse_proxy relay:9100
	}

	# Health checks
	handle /health {
		reverse_proxy relay:9100
	}

	# WebSocket 升级 → Relay
	# Caddy 自动处理 WebSocket 升级
	handle /ws/* {
		reverse_proxy relay:9100
	}
}
